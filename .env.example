# Telegram Bot API — получить у @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Google API Key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Supabase — для хранения постов в БД (таблица tele_post)
# Без настроек используется JSON в папке data/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# URL API для фронтенда (Vercel):
# - Supabase: https://YOUR_PROJECT.supabase.co/functions/v1
# - Railway: https://xxx.railway.app
VITE_API_URL=

# Publishable/Anon key (только для Supabase — убирает 401)
VITE_SUPABASE_ANON_KEY=
